// 覆盖：浮点字面量、int 与 float 的提升、整除与实数除法的分界、比较、转换与打印格式
print(1.5, 0.5, 2.0);
print(typeof(1.5), typeof(1));
print(1.0 + 2, 2 + 1.0, 1.0 + 2.0);
print(1.5 * 2, 3 - 0.5, 2.5 % 1.0);
print(10 / 3, 10 / 3.0, 1 / 2, 1 / 2.0);
print(- 1.5, - 1);
print(1 == 1.0, 1 != 1.5, 1 < 1.5, 2.0 >= 2);
print(float(3), float("2.5"), float(true), float(1.5));
print(int(1.9), int(-1.9), int(2.0));
print(str(0.5) + " 与 " + str(2.0));
a = [1, 1.5];
print(a, len(a));
type P = { x = 0.5, y = 0 };
p = P {};
print(p, p.x + 1);
print("插值里的浮点：${1.0 / 4.0} 与 ${a[1]}");
i = 0;
total = 0.0;
while i < 3
    total = total + i / 2.0;
    i = i + 1;
end
print("累加 ${total}");
