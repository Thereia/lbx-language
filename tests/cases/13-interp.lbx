// 覆盖：插值里的各类表达式、多段插值、前后缀、嵌套字符串里的插值
type P = { x = 1, y = 2 };
p = P {};
a = [1, "s", [2]];

func f(n)
    return n + 1;
end

print("结构 ${p}");
print("字段 ${p.x}，数组 ${a}，元素 ${a[2][0]}");
print("函数调用 ${f(4)}，混合表达式 ${len("ab") + f(1)}");
print("多段：${1}${2}${3}");
print("前缀${1}后缀");
print("嵌套字符串里的插值 ${"${1}"}");
print("假插值 \${1}");
print("条件结果 ${1 < 2}");